# LAMMPS benchmark input for the pe_206 Allegro model.
# Variables (override with -var on the command line):
#   model     compiled model file (.nequip.pt2)
#   nrep      replication factor per axis (1 -> 206 atoms, 2 -> 1648, 3 -> 5562, 4 -> 13184)
#   nsteps    MD steps to time
#   skin      neighbor skin distance (Angstrom)
#   nevery    neighbor list check interval
#   ensemble  nve | nvt | npt
#   temp      target temperature (K) for nvt/npt and the initial velocities
#   press     target pressure (bar) for npt
variable  model    index  model.nequip.pt2
variable  nrep     index  1
variable  nsteps   index  200
variable  skin     index  1.0
variable  nevery   index  1
variable  ensemble index  nve
variable  temp     index  300.0
variable  press    index  1.0

units         metal
atom_style    atomic
boundary      p p p
newton        on

read_data     pe206.data
replicate     ${nrep} ${nrep} ${nrep}

mass          1 12.011
mass          2 1.008

pair_style    allegro
pair_coeff    * * ${model} C H

neighbor      ${skin} bin
neigh_modify  every ${nevery} delay 0 check yes

velocity      all create ${temp} 12345 mom yes rot yes dist gaussian
timestep      0.0005

# Nose-Hoover damping: 100 steps for T, 1000 steps for P
if "${ensemble} == nve" then &
  "fix 1 all nve" &
elif "${ensemble} == nvt" &
  "fix 1 all nvt temp ${temp} ${temp} 0.05" &
elif "${ensemble} == npt" &
  "fix 1 all npt temp ${temp} ${temp} 0.05 iso ${press} ${press} 0.5"

thermo        50
thermo_style  custom step temp pe ke etotal press vol cpu
thermo_modify flush yes

# warm-up (JIT/allocation) then timed run
run           20
run           ${nsteps}
